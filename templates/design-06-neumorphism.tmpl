{{ define "design-06-neumorphism.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horaire de Miaro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #e8eef3;
            --text: #2d3748;
            --text-muted: #718096;
            --shadow-light: #ffffff;
            --shadow-dark: #c8d0d9;
            --accent: #6c63ff;
            --morning: #f6ad55;
            --afternoon: #4299e1;
            --night: #9f7aea;
            --free: #48bb78;
        }

        body {
            font-family: 'Nunito', -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .neu {
            background: var(--bg);
            border-radius: 24px;
            box-shadow:
                8px 8px 16px var(--shadow-dark),
                -8px -8px 16px var(--shadow-light);
        }

        .neu-inset {
            background: var(--bg);
            border-radius: 16px;
            box-shadow:
                inset 4px 4px 8px var(--shadow-dark),
                inset -4px -4px 8px var(--shadow-light);
        }

        header {
            text-align: center;
            padding: 2.5rem;
            margin-bottom: 2rem;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 0.9375rem;
        }

        .cards-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .card {
            padding: 2rem;
        }

        .card-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .status-display {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .status-orb {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            box-shadow:
                6px 6px 12px var(--shadow-dark),
                -6px -6px 12px var(--shadow-light);
        }

        .status-orb.working {
            background: linear-gradient(145deg, #4ade80, #22c55e);
            color: white;
        }

        .status-orb.resting {
            background: linear-gradient(145deg, #f87171, #ef4444);
            color: white;
        }

        .status-info h3 {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .status-info p {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .shift-display {
            padding: 1.25rem;
        }

        .shift-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .shift-name.morning { color: var(--morning); }
        .shift-name.afternoon { color: var(--afternoon); }
        .shift-name.night { color: var(--night); }
        .shift-name.free { color: var(--free); }

        .shift-time {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .calendar-card {
            padding: 2rem;
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .calendar-header h2 {
            font-size: 1rem;
            font-weight: 700;
        }

        .next-badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--accent);
            box-shadow:
                4px 4px 8px var(--shadow-dark),
                -4px -4px 8px var(--shadow-light);
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.625rem;
        }

        .calendar-day-header {
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            text-align: center;
            padding: 0.5rem;
            font-weight: 600;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 0.875rem;
            transition: all 0.2s ease;
            cursor: default;
            box-shadow:
                4px 4px 8px var(--shadow-dark),
                -4px -4px 8px var(--shadow-light);
        }

        .calendar-day:not(.empty):hover {
            box-shadow:
                2px 2px 4px var(--shadow-dark),
                -2px -2px 4px var(--shadow-light);
        }

        .calendar-day.empty {
            box-shadow: none;
            background: transparent;
        }

        .calendar-day.today {
            background: var(--text);
            color: white;
            box-shadow:
                4px 4px 12px rgba(45, 55, 72, 0.3),
                -4px -4px 8px var(--shadow-light);
        }

        .calendar-day.next-work {
            background: linear-gradient(145deg, var(--accent), #5a52d5);
            color: white;
            box-shadow:
                4px 4px 12px rgba(108, 99, 255, 0.3),
                -4px -4px 8px var(--shadow-light);
        }

        .day-number {
            font-weight: 700;
        }

        .shift-indicator {
            font-size: 0.5625rem;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            opacity: 0.7;
            margin-top: 2px;
        }

        .calendar-day.today .shift-indicator,
        .calendar-day.next-work .shift-indicator {
            opacity: 0.9;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            box-shadow:
                2px 2px 4px var(--shadow-dark),
                -2px -2px 4px var(--shadow-light);
        }

        .legend-dot.morning { background: var(--morning); }
        .legend-dot.afternoon { background: var(--afternoon); }
        .legend-dot.night { background: var(--night); }
        .legend-dot.free { background: var(--free); }

        footer {
            margin-top: 2rem;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.8125rem;
        }

        footer a {
            color: var(--accent);
            text-decoration: none;
        }

        @media (max-width: 640px) {
            .cards-row {
                grid-template-columns: 1fr;
            }
            .calendar-grid {
                gap: 0.375rem;
            }
            .calendar-day {
                font-size: 0.75rem;
                border-radius: 8px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="neu">
            <h1>Horaire de Miaro</h1>
            <p class="subtitle">Suivi en temps réel du planning</p>
        </header>

        <div class="cards-row">
            <div class="card neu">
                <div class="card-label">Statut</div>
                <div class="status-display">
                    {{ if eq .IsWorking "est au travail" }}
                    <div class="status-orb working">✓</div>
                    <div class="status-info">
                        <h3>Au travail</h3>
                        <p>Actuellement en service</p>
                    </div>
                    {{ else }}
                    <div class="status-orb resting">○</div>
                    <div class="status-info">
                        <h3>Repos</h3>
                        <p>Pas en service</p>
                    </div>
                    {{ end }}
                </div>
            </div>

            <div class="card neu">
                <div class="card-label">Équipe</div>
                <div class="shift-display neu-inset">
                    {{ if eq .Schedule "du matin" }}
                    <div class="shift-name morning">Matin</div>
                    <div class="shift-time">06:00 – 14:00</div>
                    {{ else if eq .Schedule "de l'après-midi" }}
                    <div class="shift-name afternoon">Après-midi</div>
                    <div class="shift-time">14:00 – 22:00</div>
                    {{ else if eq .Schedule "de nuit" }}
                    <div class="shift-name night">Nuit</div>
                    <div class="shift-time">22:00 – 06:00</div>
                    {{ else }}
                    <div class="shift-name free">Libre</div>
                    <div class="shift-time">Jour de repos</div>
                    {{ end }}
                </div>
            </div>
        </div>

        <div class="calendar-card neu">
            <div class="calendar-header">
                <h2>Planning du mois</h2>
                <span class="next-badge">Prochain: {{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}</span>
            </div>

            <div class="calendar-grid">
                <div class="calendar-day-header">Lun</div>
                <div class="calendar-day-header">Mar</div>
                <div class="calendar-day-header">Mer</div>
                <div class="calendar-day-header">Jeu</div>
                <div class="calendar-day-header">Ven</div>
                <div class="calendar-day-header">Sam</div>
                <div class="calendar-day-header">Dim</div>

                {{ range .CalendarDays }}
                <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                    {{ if not .IsEmpty }}
                    <div class="day-number">{{ .DayNumber }}</div>
                    <div class="shift-indicator">{{ .ShiftType }}</div>
                    {{ end }}
                </div>
                {{ end }}
            </div>

            <div class="legend">
                <div class="legend-item"><div class="legend-dot morning"></div> Matin</div>
                <div class="legend-item"><div class="legend-dot afternoon"></div> Après-midi</div>
                <div class="legend-item"><div class="legend-dot night"></div> Nuit</div>
                <div class="legend-item"><div class="legend-dot free"></div> Libre</div>
            </div>
        </div>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api">Miaro Scheduler API</a>
        </footer>
    </div>
</body>
</html>
{{ end }}
