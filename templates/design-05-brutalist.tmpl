{{ define "design-05-brutalist.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MIARO // SCHEDULE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #fffef5;
            --text: #000;
            --accent: #0000ff;
            --morning: #ff6600;
            --afternoon: #0066ff;
            --night: #6600ff;
            --free: #00cc66;
        }

        body {
            font-family: 'Space Mono', monospace;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        header {
            border: 4px solid var(--text);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        h1 {
            font-size: 3rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .subtitle {
            font-size: 0.875rem;
            margin-top: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .block {
            border: 4px solid var(--text);
        }

        .block-header {
            background: var(--text);
            color: var(--bg);
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 700;
        }

        .block-body {
            padding: 1.5rem;
        }

        .status-display {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .status-indicator {
            width: 24px;
            height: 24px;
            border: 3px solid currentColor;
        }

        .status-indicator.working {
            background: var(--free);
            border-color: var(--free);
        }

        .status-indicator.resting {
            background: transparent;
            border-color: var(--text);
        }

        .status-text {
            font-size: 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .shift-name {
            font-size: 2rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .shift-name.morning { color: var(--morning); }
        .shift-name.afternoon { color: var(--afternoon); }
        .shift-name.night { color: var(--night); }
        .shift-name.free { color: var(--free); }

        .shift-time {
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .calendar-block {
            grid-column: span 2;
            margin-top: 2rem;
        }

        .next-work-banner {
            background: var(--accent);
            color: white;
            padding: 0.75rem 1rem;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            border: 4px solid var(--text);
            border-top: none;
        }

        .calendar-header {
            background: var(--text);
            color: var(--bg);
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-align: center;
            padding: 0.75rem 0.25rem;
            font-weight: 700;
            border-right: 2px solid var(--bg);
        }

        .calendar-header:last-child {
            border-right: none;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-right: 2px solid var(--text);
            border-bottom: 2px solid var(--text);
            font-size: 0.875rem;
            transition: all 0.1s;
        }

        .calendar-day:nth-child(7n) {
            border-right: none;
        }

        .calendar-day:not(.empty):hover {
            background: var(--text);
            color: var(--bg);
        }

        .calendar-day.empty {
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 5px,
                rgba(0,0,0,0.03) 5px,
                rgba(0,0,0,0.03) 10px
            );
        }

        .calendar-day.today {
            background: var(--text);
            color: var(--bg);
        }

        .calendar-day.next-work {
            background: var(--accent);
            color: white;
        }

        .day-number {
            font-weight: 700;
            font-size: 1rem;
        }

        .shift-indicator {
            font-size: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 2px;
        }

        .legend {
            display: flex;
            gap: 2rem;
            padding: 1.5rem;
            border: 4px solid var(--text);
            border-top: none;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .legend-box {
            width: 16px;
            height: 16px;
            border: 2px solid var(--text);
        }

        .legend-box.morning { background: var(--morning); border-color: var(--morning); }
        .legend-box.afternoon { background: var(--afternoon); border-color: var(--afternoon); }
        .legend-box.night { background: var(--night); border-color: var(--night); }
        .legend-box.free { background: var(--free); border-color: var(--free); }

        footer {
            margin-top: 2rem;
            padding: 1rem;
            border: 4px solid var(--text);
            text-align: center;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        footer a {
            color: var(--accent);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .calendar-block {
                grid-column: span 1;
            }
            h1 {
                font-size: 2rem;
            }
            .shift-name {
                font-size: 1.5rem;
            }
            .legend {
                flex-wrap: wrap;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>MIARO<br>SCHEDULE</h1>
            <p class="subtitle">// Suivi en temps réel</p>
        </header>

        <div class="main-grid">
            <div class="block">
                <div class="block-header">Statut</div>
                <div class="block-body">
                    <div class="status-display">
                        {{ if eq .IsWorking "est au travail" }}
                        <div class="status-indicator working"></div>
                        <div class="status-text">Au travail</div>
                        {{ else }}
                        <div class="status-indicator resting"></div>
                        <div class="status-text">Repos</div>
                        {{ end }}
                    </div>
                </div>
            </div>

            <div class="block">
                <div class="block-header">Équipe</div>
                <div class="block-body">
                    {{ if eq .Schedule "du matin" }}
                    <div class="shift-name morning">Matin</div>
                    <div class="shift-time">06:00 → 14:00</div>
                    {{ else if eq .Schedule "de l'après-midi" }}
                    <div class="shift-name afternoon">Après-midi</div>
                    <div class="shift-time">14:00 → 22:00</div>
                    {{ else if eq .Schedule "de nuit" }}
                    <div class="shift-name night">Nuit</div>
                    <div class="shift-time">22:00 → 06:00</div>
                    {{ else }}
                    <div class="shift-name free">Libre</div>
                    <div class="shift-time">Jour de repos</div>
                    {{ end }}
                </div>
            </div>

            <div class="calendar-block">
                <div class="next-work-banner">
                    Prochain travail → {{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}
                </div>
                <div class="calendar-grid">
                    <div class="calendar-header">Lun</div>
                    <div class="calendar-header">Mar</div>
                    <div class="calendar-header">Mer</div>
                    <div class="calendar-header">Jeu</div>
                    <div class="calendar-header">Ven</div>
                    <div class="calendar-header">Sam</div>
                    <div class="calendar-header">Dim</div>

                    {{ range .CalendarDays }}
                    <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                        {{ if not .IsEmpty }}
                        <div class="day-number">{{ .DayNumber }}</div>
                        <div class="shift-indicator">{{ .ShiftType }}</div>
                        {{ end }}
                    </div>
                    {{ end }}
                </div>
                <div class="legend">
                    <div class="legend-item"><div class="legend-box morning"></div> Matin</div>
                    <div class="legend-item"><div class="legend-box afternoon"></div> Après-midi</div>
                    <div class="legend-item"><div class="legend-box night"></div> Nuit</div>
                    <div class="legend-item"><div class="legend-box free"></div> Libre</div>
                </div>
            </div>
        </div>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api">Miaro Scheduler API</a> // 2024
        </footer>
    </div>
</body>
</html>
{{ end }}
