{{ define "design-03-glassmorphism.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horaire de Miaro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --morning: #f59e0b;
            --afternoon: #0ea5e9;
            --night: #8b5cf6;
            --free: #10b981;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            background-attachment: fixed;
            color: white;
            padding: 2rem;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .glass {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
        }

        header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            opacity: 0.8;
            font-size: 1rem;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .card {
            padding: 1.5rem;
        }

        .card-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            opacity: 0.7;
            margin-bottom: 1rem;
        }

        .status-row {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .status-orb {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .status-orb.working {
            background: rgba(16, 185, 129, 0.3);
            border: 2px solid rgba(16, 185, 129, 0.6);
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.4);
        }

        .status-orb.resting {
            background: rgba(239, 68, 68, 0.3);
            border: 2px solid rgba(239, 68, 68, 0.6);
        }

        .status-text {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .status-sub {
            font-size: 0.875rem;
            opacity: 0.7;
        }

        .shift-display {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .shift-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .shift-icon.morning { background: rgba(245, 158, 11, 0.3); border: 2px solid rgba(245, 158, 11, 0.5); }
        .shift-icon.afternoon { background: rgba(14, 165, 233, 0.3); border: 2px solid rgba(14, 165, 233, 0.5); }
        .shift-icon.night { background: rgba(139, 92, 246, 0.3); border: 2px solid rgba(139, 92, 246, 0.5); }
        .shift-icon.free { background: rgba(16, 185, 129, 0.3); border: 2px solid rgba(16, 185, 129, 0.5); }

        .shift-info h3 {
            font-size: 1.125rem;
            font-weight: 600;
        }

        .shift-info p {
            font-size: 0.875rem;
            opacity: 0.7;
        }

        .calendar-card {
            padding: 1.5rem;
        }

        .calendar-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .next-work-badge {
            background: rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.875rem;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }

        .calendar-day-header {
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            opacity: 0.6;
            text-align: center;
            padding: 0.5rem;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            font-size: 0.875rem;
            transition: all 0.2s ease;
            cursor: default;
        }

        .calendar-day:not(.empty):hover {
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.05);
        }

        .calendar-day.empty {
            background: transparent;
        }

        .calendar-day.today {
            background: rgba(255, 255, 255, 0.9);
            color: #1a1a1a;
            font-weight: 700;
        }

        .calendar-day.next-work {
            background: var(--free);
            color: white;
            font-weight: 700;
            box-shadow: 0 0 25px rgba(16, 185, 129, 0.5);
        }

        .day-number {
            font-weight: 600;
        }

        .shift-indicator {
            font-size: 0.5625rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            opacity: 0.7;
            margin-top: 2px;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            opacity: 0.8;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .legend-dot.morning { background: var(--morning); }
        .legend-dot.afternoon { background: var(--afternoon); }
        .legend-dot.night { background: var(--night); }
        .legend-dot.free { background: var(--free); }

        footer {
            margin-top: 2rem;
            text-align: center;
            opacity: 0.6;
            font-size: 0.875rem;
        }

        footer a {
            color: white;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        @media (max-width: 640px) {
            .cards-grid {
                grid-template-columns: 1fr;
            }
            h1 {
                font-size: 2rem;
            }
            .calendar-day {
                font-size: 0.75rem;
                border-radius: 8px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="glass">
            <h1>Horaire de Miaro</h1>
            <p class="subtitle">Suivi en temps réel du planning</p>
        </header>

        <div class="cards-grid">
            <div class="card glass">
                <div class="card-label">Statut actuel</div>
                <div class="status-row">
                    {{ if eq .IsWorking "est au travail" }}
                    <div class="status-orb working">✓</div>
                    <div>
                        <div class="status-text">Au travail</div>
                        <div class="status-sub">En service</div>
                    </div>
                    {{ else }}
                    <div class="status-orb resting">○</div>
                    <div>
                        <div class="status-text">Repos</div>
                        <div class="status-sub">Hors service</div>
                    </div>
                    {{ end }}
                </div>
            </div>

            <div class="card glass">
                <div class="card-label">Équipe</div>
                <div class="shift-display">
                    {{ if eq .Schedule "du matin" }}
                    <div class="shift-icon morning">☀</div>
                    <div class="shift-info">
                        <h3>Matin</h3>
                        <p>06:00 – 14:00</p>
                    </div>
                    {{ else if eq .Schedule "de l'après-midi" }}
                    <div class="shift-icon afternoon">◐</div>
                    <div class="shift-info">
                        <h3>Après-midi</h3>
                        <p>14:00 – 22:00</p>
                    </div>
                    {{ else if eq .Schedule "de nuit" }}
                    <div class="shift-icon night">☾</div>
                    <div class="shift-info">
                        <h3>Nuit</h3>
                        <p>22:00 – 06:00</p>
                    </div>
                    {{ else }}
                    <div class="shift-icon free">✓</div>
                    <div class="shift-info">
                        <h3>Libre</h3>
                        <p>Jour de repos</p>
                    </div>
                    {{ end }}
                </div>
            </div>
        </div>

        <div class="calendar-card glass">
            <div class="calendar-header-row">
                <div class="card-label" style="margin: 0;">Planning du mois</div>
                <div class="next-work-badge">Prochain: {{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}</div>
            </div>

            <div class="calendar-grid">
                <div class="calendar-day-header">Lun</div>
                <div class="calendar-day-header">Mar</div>
                <div class="calendar-day-header">Mer</div>
                <div class="calendar-day-header">Jeu</div>
                <div class="calendar-day-header">Ven</div>
                <div class="calendar-day-header">Sam</div>
                <div class="calendar-day-header">Dim</div>

                {{ range .CalendarDays }}
                <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                    {{ if not .IsEmpty }}
                    <div class="day-number">{{ .DayNumber }}</div>
                    <div class="shift-indicator">{{ .ShiftType }}</div>
                    {{ end }}
                </div>
                {{ end }}
            </div>

            <div class="legend">
                <div class="legend-item"><div class="legend-dot morning"></div> Matin</div>
                <div class="legend-item"><div class="legend-dot afternoon"></div> Après-midi</div>
                <div class="legend-item"><div class="legend-dot night"></div> Nuit</div>
                <div class="legend-item"><div class="legend-dot free"></div> Libre</div>
            </div>
        </div>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api">Miaro Scheduler API</a>
        </footer>
    </div>
</body>
</html>
{{ end }}
