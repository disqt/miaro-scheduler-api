{{ define "design-10-terminal.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>miaro@schedule:~$</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #0d1117;
            --surface: #161b22;
            --border: #30363d;
            --text: #c9d1d9;
            --text-muted: #8b949e;
            --green: #3fb950;
            --red: #f85149;
            --yellow: #d29922;
            --blue: #58a6ff;
            --purple: #a371f7;
            --cyan: #39c5cf;
        }

        body {
            font-family: 'JetBrains Mono', 'Monaco', 'Courier New', monospace;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
            padding: 1rem;
            font-size: 14px;
        }

        .terminal {
            max-width: 900px;
            margin: 0 auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
        }

        .terminal-header {
            background: var(--bg);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 1px solid var(--border);
        }

        .terminal-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .terminal-btn {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .terminal-btn.close { background: #ff5f56; }
        .terminal-btn.minimize { background: #ffbd2e; }
        .terminal-btn.maximize { background: #27c93f; }

        .terminal-title {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .terminal-body {
            padding: 1.5rem;
        }

        .line {
            margin-bottom: 0.5rem;
        }

        .prompt {
            color: var(--green);
        }

        .command {
            color: var(--cyan);
        }

        .comment {
            color: var(--text-muted);
        }

        .output {
            padding-left: 1rem;
            margin: 0.5rem 0;
        }

        .status-working {
            color: var(--green);
        }

        .status-resting {
            color: var(--red);
        }

        .shift-morning { color: var(--yellow); }
        .shift-afternoon { color: var(--blue); }
        .shift-night { color: var(--purple); }
        .shift-free { color: var(--green); }

        .section {
            margin: 1.5rem 0;
            padding: 1rem;
            background: var(--bg);
            border-radius: 6px;
            border: 1px solid var(--border);
        }

        .section-title {
            color: var(--cyan);
            margin-bottom: 0.75rem;
            font-weight: 600;
        }

        .calendar-ascii {
            font-size: 0.75rem;
            line-height: 1.4;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 2px;
            margin-top: 0.5rem;
        }

        .calendar-header {
            color: var(--text-muted);
            text-align: center;
            padding: 0.5rem 0;
            font-size: 0.6875rem;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: var(--bg);
            border: 1px solid var(--border);
            font-size: 0.75rem;
            transition: all 0.15s;
        }

        .calendar-day:not(.empty):hover {
            border-color: var(--cyan);
        }

        .calendar-day.empty {
            background: transparent;
            border-color: transparent;
        }

        .calendar-day.today {
            background: var(--green);
            color: var(--bg);
            border-color: var(--green);
            font-weight: 700;
        }

        .calendar-day.next-work {
            background: var(--cyan);
            color: var(--bg);
            border-color: var(--cyan);
            font-weight: 700;
        }

        .day-number {
            font-weight: 600;
        }

        .shift-indicator {
            font-size: 0.5rem;
            text-transform: uppercase;
            opacity: 0.8;
            margin-top: 1px;
        }

        .calendar-day.today .shift-indicator,
        .calendar-day.next-work .shift-indicator {
            opacity: 1;
        }

        .legend-row {
            display: flex;
            gap: 1.5rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
        }

        .legend-box {
            width: 12px;
            height: 12px;
            border: 1px solid;
        }

        .legend-box.morning { border-color: var(--yellow); background: rgba(210, 153, 34, 0.3); }
        .legend-box.afternoon { border-color: var(--blue); background: rgba(88, 166, 255, 0.3); }
        .legend-box.night { border-color: var(--purple); background: rgba(163, 113, 247, 0.3); }
        .legend-box.free { border-color: var(--green); background: rgba(63, 185, 80, 0.3); }

        .cursor {
            display: inline-block;
            width: 8px;
            height: 16px;
            background: var(--green);
            animation: blink 1s infinite;
            vertical-align: middle;
            margin-left: 0.25rem;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        footer {
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            font-size: 0.75rem;
        }

        footer a {
            color: var(--cyan);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        @media (max-width: 640px) {
            body {
                font-size: 12px;
            }
            .calendar-day {
                font-size: 0.625rem;
            }
            .shift-indicator {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="terminal">
        <div class="terminal-header">
            <div class="terminal-buttons">
                <span class="terminal-btn close"></span>
                <span class="terminal-btn minimize"></span>
                <span class="terminal-btn maximize"></span>
            </div>
            <span class="terminal-title">miaro@schedule:~</span>
        </div>

        <div class="terminal-body">
            <div class="line">
                <span class="prompt">miaro@schedule:~$</span> <span class="command">./check_status.sh</span>
            </div>
            <div class="output">
                <span class="comment"># Vérification du statut...</span>
            </div>
            <div class="output">
                {{ if eq .IsWorking "est au travail" }}
                STATUS: <span class="status-working">[ONLINE]</span> Au travail
                {{ else }}
                STATUS: <span class="status-resting">[OFFLINE]</span> Repos
                {{ end }}
            </div>

            <div class="line" style="margin-top: 1.5rem;">
                <span class="prompt">miaro@schedule:~$</span> <span class="command">cat /var/schedule/current</span>
            </div>
            <div class="output">
                {{ if eq .Schedule "du matin" }}
                SHIFT: <span class="shift-morning">MATIN</span> (06:00 → 14:00)
                {{ else if eq .Schedule "de l'après-midi" }}
                SHIFT: <span class="shift-afternoon">APRÈS-MIDI</span> (14:00 → 22:00)
                {{ else if eq .Schedule "de nuit" }}
                SHIFT: <span class="shift-night">NUIT</span> (22:00 → 06:00)
                {{ else }}
                SHIFT: <span class="shift-free">LIBRE</span> (jour de repos)
                {{ end }}
            </div>

            <div class="line" style="margin-top: 1.5rem;">
                <span class="prompt">miaro@schedule:~$</span> <span class="command">./next_work.sh</span>
            </div>
            <div class="output">
                NEXT_WORK: <span class="status-working">{{ if eq .NextWorkingDay "demain" }}DEMAIN{{ else }}{{ .NextWorkingDay | title }}{{ end }}</span>
            </div>

            <div class="section">
                <div class="section-title">$ cal --schedule</div>
                <div class="calendar-grid">
                    <div class="calendar-header">LUN</div>
                    <div class="calendar-header">MAR</div>
                    <div class="calendar-header">MER</div>
                    <div class="calendar-header">JEU</div>
                    <div class="calendar-header">VEN</div>
                    <div class="calendar-header">SAM</div>
                    <div class="calendar-header">DIM</div>

                    {{ range .CalendarDays }}
                    <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                        {{ if not .IsEmpty }}
                        <div class="day-number">{{ .DayNumber }}</div>
                        <div class="shift-indicator">{{ .ShiftType }}</div>
                        {{ end }}
                    </div>
                    {{ end }}
                </div>

                <div class="legend-row">
                    <div class="legend-item"><div class="legend-box morning"></div> <span class="shift-morning">Matin</span></div>
                    <div class="legend-item"><div class="legend-box afternoon"></div> <span class="shift-afternoon">Après-midi</span></div>
                    <div class="legend-item"><div class="legend-box night"></div> <span class="shift-night">Nuit</span></div>
                    <div class="legend-item"><div class="legend-box free"></div> <span class="shift-free">Libre</span></div>
                </div>
            </div>

            <div class="line">
                <span class="prompt">miaro@schedule:~$</span><span class="cursor"></span>
            </div>

            <footer>
                <span class="comment"># Source: <a href="https://github.com/disqt/miaro-scheduler-api">github.com/disqt/miaro-scheduler-api</a></span>
            </footer>
        </div>
    </div>
</body>
</html>
{{ end }}
