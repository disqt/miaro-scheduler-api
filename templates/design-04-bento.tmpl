{{ define "design-04-bento.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horaire de Miaro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #f8fafc;
            --card-bg: white;
            --text: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --accent: #6366f1;
            --morning: #f97316;
            --afternoon: #0ea5e9;
            --night: #8b5cf6;
            --free: #22c55e;
        }

        body {
            font-family: 'Outfit', -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            min-height: 100vh;
            padding: 1.5rem;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .bento-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: auto auto auto;
            gap: 1rem;
        }

        .bento-item {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid var(--border);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .bento-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.08);
        }

        /* Title - spans 2 columns */
        .bento-title {
            grid-column: span 2;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .bento-title h1 {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.25rem;
        }

        .bento-title p {
            color: var(--text-muted);
            font-size: 0.9375rem;
        }

        /* Status - 1 column */
        .bento-status {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .status-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            font-size: 1.5rem;
        }

        .status-circle.working {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            box-shadow: 0 8px 24px rgba(34, 197, 94, 0.3);
        }

        .status-circle.resting {
            background: linear-gradient(135deg, #f87171, #ef4444);
            color: white;
        }

        .status-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
        }

        .status-value {
            font-weight: 600;
            font-size: 1rem;
            margin-top: 0.25rem;
        }

        /* Shift - 1 column */
        .bento-shift {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .shift-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
        }

        .shift-name {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .shift-name.morning { color: var(--morning); }
        .shift-name.afternoon { color: var(--afternoon); }
        .shift-name.night { color: var(--night); }
        .shift-name.free { color: var(--free); }

        .shift-time {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        /* Calendar - spans all 4 columns */
        .bento-calendar {
            grid-column: span 4;
        }

        .calendar-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .calendar-title h2 {
            font-size: 1rem;
            font-weight: 600;
        }

        .next-badge {
            background: var(--accent);
            color: white;
            padding: 0.375rem 0.875rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }

        .calendar-header {
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            text-align: center;
            padding: 0.5rem;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: var(--bg);
            font-size: 0.875rem;
            transition: all 0.15s ease;
        }

        .calendar-day:not(.empty):hover {
            background: #e2e8f0;
        }

        .calendar-day.empty {
            background: transparent;
        }

        .calendar-day.today {
            background: var(--text);
            color: white;
            font-weight: 700;
        }

        .calendar-day.next-work {
            background: var(--accent);
            color: white;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
        }

        .day-number {
            font-weight: 600;
        }

        .shift-indicator {
            font-size: 0.5625rem;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            opacity: 0.6;
            margin-top: 2px;
        }

        .calendar-day.today .shift-indicator,
        .calendar-day.next-work .shift-indicator {
            opacity: 0.85;
        }

        /* Legend - spans 4 columns */
        .bento-legend {
            grid-column: span 4;
            display: flex;
            justify-content: center;
            gap: 2rem;
            padding: 1rem;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .legend-color {
            width: 14px;
            height: 14px;
            border-radius: 4px;
        }

        .legend-color.morning { background: var(--morning); }
        .legend-color.afternoon { background: var(--afternoon); }
        .legend-color.night { background: var(--night); }
        .legend-color.free { background: var(--free); }

        footer {
            text-align: center;
            margin-top: 2rem;
            color: var(--text-muted);
            font-size: 0.8125rem;
        }

        footer a {
            color: var(--accent);
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .bento-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .bento-title {
                grid-column: span 2;
            }
            .bento-calendar {
                grid-column: span 2;
            }
            .bento-legend {
                grid-column: span 2;
                gap: 1rem;
                flex-wrap: wrap;
            }
        }

        @media (max-width: 480px) {
            .bento-title, .bento-status, .bento-shift {
                grid-column: span 2;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="bento-grid">
            <div class="bento-item bento-title">
                <h1>Horaire de Miaro</h1>
                <p>Suivi en temps réel du planning de travail</p>
            </div>

            <div class="bento-item bento-status">
                {{ if eq .IsWorking "est au travail" }}
                <div class="status-circle working">✓</div>
                {{ else }}
                <div class="status-circle resting">○</div>
                {{ end }}
                <div class="status-label">Statut</div>
                <div class="status-value">
                    {{ if eq .IsWorking "est au travail" }}Au travail{{ else }}Repos{{ end }}
                </div>
            </div>

            <div class="bento-item bento-shift">
                <div class="shift-label">Équipe</div>
                {{ if eq .Schedule "du matin" }}
                <div class="shift-name morning">Matin</div>
                <div class="shift-time">06:00 – 14:00</div>
                {{ else if eq .Schedule "de l'après-midi" }}
                <div class="shift-name afternoon">Après-midi</div>
                <div class="shift-time">14:00 – 22:00</div>
                {{ else if eq .Schedule "de nuit" }}
                <div class="shift-name night">Nuit</div>
                <div class="shift-time">22:00 – 06:00</div>
                {{ else }}
                <div class="shift-name free">Libre</div>
                <div class="shift-time">Jour de repos</div>
                {{ end }}
            </div>

            <div class="bento-item bento-calendar">
                <div class="calendar-title">
                    <h2>Planning du mois</h2>
                    <span class="next-badge">Prochain: {{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}</span>
                </div>
                <div class="calendar-grid">
                    <div class="calendar-header">Lun</div>
                    <div class="calendar-header">Mar</div>
                    <div class="calendar-header">Mer</div>
                    <div class="calendar-header">Jeu</div>
                    <div class="calendar-header">Ven</div>
                    <div class="calendar-header">Sam</div>
                    <div class="calendar-header">Dim</div>

                    {{ range .CalendarDays }}
                    <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                        {{ if not .IsEmpty }}
                        <div class="day-number">{{ .DayNumber }}</div>
                        <div class="shift-indicator">{{ .ShiftType }}</div>
                        {{ end }}
                    </div>
                    {{ end }}
                </div>
            </div>

            <div class="bento-item bento-legend">
                <div class="legend-item"><div class="legend-color morning"></div> Matin</div>
                <div class="legend-item"><div class="legend-color afternoon"></div> Après-midi</div>
                <div class="legend-item"><div class="legend-color night"></div> Nuit</div>
                <div class="legend-item"><div class="legend-color free"></div> Libre</div>
            </div>
        </div>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api">Miaro Scheduler API</a>
        </footer>
    </div>
</body>
</html>
{{ end }}
