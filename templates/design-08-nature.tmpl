{{ define "design-08-nature.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horaire de Miaro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #faf8f5;
            --card-bg: #ffffff;
            --text: #2d3a2d;
            --text-muted: #6b7c6b;
            --border: #e5e8e0;
            --sage: #87a878;
            --sage-light: #e8f0e4;
            --terracotta: #c4846c;
            --sand: #d4c4a8;
            --stone: #8b8b7a;
            --morning: #e8b87c;
            --afternoon: #7ca3c4;
            --night: #9b8bb4;
            --free: #87a878;
        }

        body {
            font-family: 'Source Sans 3', -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 3rem;
            padding: 3rem 2rem;
            background: linear-gradient(180deg, var(--sage-light) 0%, var(--bg) 100%);
            border-radius: 24px;
        }

        h1 {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 2.5rem;
            font-weight: 400;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 1rem;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 1.75rem;
            border: 1px solid var(--border);
        }

        .card-label {
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .status-display {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .status-leaf {
            width: 48px;
            height: 48px;
            border-radius: 50% 0 50% 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .status-leaf.working {
            background: var(--sage);
            color: white;
        }

        .status-leaf.resting {
            background: var(--sand);
            color: var(--text);
        }

        .status-info h3 {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 1.25rem;
            font-weight: 400;
        }

        .status-info p {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .shift-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-bottom: 1rem;
        }

        .shift-icon.morning { background: rgba(232, 184, 124, 0.2); color: var(--morning); }
        .shift-icon.afternoon { background: rgba(124, 163, 196, 0.2); color: var(--afternoon); }
        .shift-icon.night { background: rgba(155, 139, 180, 0.2); color: var(--night); }
        .shift-icon.free { background: var(--sage-light); color: var(--sage); }

        .shift-name {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 1.5rem;
            font-weight: 400;
            margin-bottom: 0.25rem;
        }

        .shift-name.morning { color: var(--morning); }
        .shift-name.afternoon { color: var(--afternoon); }
        .shift-name.night { color: var(--night); }
        .shift-name.free { color: var(--sage); }

        .shift-time {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .calendar-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 1.75rem;
            border: 1px solid var(--border);
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .calendar-header h2 {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 1.125rem;
            font-weight: 400;
        }

        .next-badge {
            background: var(--sage-light);
            color: var(--sage);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }

        .calendar-day-header {
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            text-align: center;
            padding: 0.5rem;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 0.875rem;
            background: var(--bg);
            transition: all 0.2s ease;
        }

        .calendar-day:not(.empty):hover {
            background: var(--sage-light);
        }

        .calendar-day.empty {
            background: transparent;
        }

        .calendar-day.today {
            background: var(--text);
            color: white;
        }

        .calendar-day.next-work {
            background: var(--sage);
            color: white;
        }

        .day-number {
            font-weight: 600;
        }

        .shift-indicator {
            font-size: 0.5625rem;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            opacity: 0.6;
            margin-top: 2px;
        }

        .calendar-day.today .shift-indicator,
        .calendar-day.next-work .shift-indicator {
            opacity: 0.85;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .legend-dot.morning { background: var(--morning); }
        .legend-dot.afternoon { background: var(--afternoon); }
        .legend-dot.night { background: var(--night); }
        .legend-dot.free { background: var(--sage); }

        footer {
            margin-top: 3rem;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        footer a {
            color: var(--sage);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        @media (max-width: 640px) {
            .cards-grid {
                grid-template-columns: 1fr;
            }
            h1 {
                font-size: 2rem;
            }
            .calendar-day {
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Horaire de Miaro</h1>
            <p class="subtitle">Suivi du planning de travail</p>
        </header>

        <div class="cards-grid">
            <div class="card">
                <div class="card-label">Statut actuel</div>
                <div class="status-display">
                    {{ if eq .IsWorking "est au travail" }}
                    <div class="status-leaf working">✓</div>
                    <div class="status-info">
                        <h3>Au travail</h3>
                        <p>En service</p>
                    </div>
                    {{ else }}
                    <div class="status-leaf resting">○</div>
                    <div class="status-info">
                        <h3>Repos</h3>
                        <p>Hors service</p>
                    </div>
                    {{ end }}
                </div>
            </div>

            <div class="card">
                <div class="card-label">Équipe</div>
                {{ if eq .Schedule "du matin" }}
                <div class="shift-icon morning">☀</div>
                <div class="shift-name morning">Matin</div>
                <div class="shift-time">06:00 – 14:00</div>
                {{ else if eq .Schedule "de l'après-midi" }}
                <div class="shift-icon afternoon">◐</div>
                <div class="shift-name afternoon">Après-midi</div>
                <div class="shift-time">14:00 – 22:00</div>
                {{ else if eq .Schedule "de nuit" }}
                <div class="shift-icon night">☾</div>
                <div class="shift-name night">Nuit</div>
                <div class="shift-time">22:00 – 06:00</div>
                {{ else }}
                <div class="shift-icon free">✓</div>
                <div class="shift-name free">Libre</div>
                <div class="shift-time">Jour de repos</div>
                {{ end }}
            </div>
        </div>

        <div class="calendar-card">
            <div class="calendar-header">
                <h2>Planning du mois</h2>
                <span class="next-badge">Prochain: {{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}</span>
            </div>

            <div class="calendar-grid">
                <div class="calendar-day-header">Lun</div>
                <div class="calendar-day-header">Mar</div>
                <div class="calendar-day-header">Mer</div>
                <div class="calendar-day-header">Jeu</div>
                <div class="calendar-day-header">Ven</div>
                <div class="calendar-day-header">Sam</div>
                <div class="calendar-day-header">Dim</div>

                {{ range .CalendarDays }}
                <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                    {{ if not .IsEmpty }}
                    <div class="day-number">{{ .DayNumber }}</div>
                    <div class="shift-indicator">{{ .ShiftType }}</div>
                    {{ end }}
                </div>
                {{ end }}
            </div>

            <div class="legend">
                <div class="legend-item"><div class="legend-dot morning"></div> Matin</div>
                <div class="legend-item"><div class="legend-dot afternoon"></div> Après-midi</div>
                <div class="legend-item"><div class="legend-dot night"></div> Nuit</div>
                <div class="legend-item"><div class="legend-dot free"></div> Libre</div>
            </div>
        </div>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api">Miaro Scheduler API</a>
        </footer>
    </div>
</body>
</html>
{{ end }}
