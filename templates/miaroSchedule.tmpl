{{ define "miaroSchedule.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horaire de Miaro - Scheduler API</title>

    <!-- Bootswatch Lux Theme -->
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/lux/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --lux-primary: #1a1a1a;
            --lux-success: #4bbf73;
            --lux-info: #1f9bcf;
            --lux-warning: #f0ad4e;
            --lux-danger: #d9534f;
            --lux-light: #f0f1f2;
        }

        body {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 1000px;
        }

        /* Header */
        .page-header {
            text-align: center;
            color: white;
            margin-bottom: 3rem;
        }

        .page-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }

        .page-header .subtitle {
            font-size: 1rem;
            opacity: 0.8;
            font-weight: 300;
        }

        /* Cards */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .card-header {
            background: var(--lux-primary);
            color: white;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 1rem 1.5rem;
            border: none;
        }

        .card-body {
            padding: 2rem;
        }

        /* Status Badge */
        .status-container {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.875rem 1.5rem;
            border-radius: 8px;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .status-badge.working {
            background: rgba(75, 191, 115, 0.15);
            color: var(--lux-success);
            border: 2px solid var(--lux-success);
        }

        .status-badge.not-working {
            background: rgba(217, 85, 79, 0.15);
            color: var(--lux-danger);
            border: 2px solid var(--lux-danger);
        }

        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }

        .status-badge.working .status-indicator {
            background: var(--lux-success);
            box-shadow: 0 0 8px var(--lux-success);
        }

        .status-badge.not-working .status-indicator {
            background: var(--lux-danger);
            box-shadow: 0 0 8px var(--lux-danger);
        }

        /* Schedule Info */
        .schedule-info {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            padding: 1.5rem;
            background: var(--lux-light);
            border-radius: 8px;
            border-left: 4px solid;
        }

        .schedule-details h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 0 0.5rem 0;
        }

        .schedule-time {
            font-size: 1rem;
            opacity: 0.8;
            margin: 0;
            font-family: 'Monaco', 'Courier New', monospace;
        }

        /* Shift Colors */
        .shift-morning .schedule-info {
            border-left-color: #f0ad4e;
        }
        .shift-morning .schedule-details h3 {
            color: #f0ad4e;
        }

        .shift-afternoon .schedule-info {
            border-left-color: #1f9bcf;
        }
        .shift-afternoon .schedule-details h3 {
            color: #1f9bcf;
        }

        .shift-night .schedule-info {
            border-left-color: #6f42c1;
        }
        .shift-night .schedule-details h3 {
            color: #6f42c1;
        }

        .shift-free .schedule-info {
            border-left-color: #4bbf73;
        }
        .shift-free .schedule-details h3 {
            color: #4bbf73;
        }

        /* Calendar */
        .calendar-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .calendar-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }

        .calendar-day-header {
            text-align: center;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            padding: 0.5rem;
            color: #666;
        }

        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: var(--lux-light);
            font-size: 0.875rem;
            position: relative;
            cursor: default;
            transition: transform 0.2s;
        }

        .calendar-day:not(.empty):hover {
            transform: scale(1.05);
        }

        .calendar-day.empty {
            background: transparent;
        }

        .calendar-day.today {
            background: var(--lux-primary);
            color: white;
            font-weight: 700;
        }

        .calendar-day.next-work {
            background: var(--lux-success);
            color: white;
            font-weight: 700;
            box-shadow: 0 0 12px rgba(75, 191, 115, 0.4);
        }

        .calendar-day .day-number {
            font-size: 1rem;
            font-weight: 600;
        }

        .calendar-day .shift-indicator {
            font-size: 0.625rem;
            margin-top: 0.25rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Legend */
        .calendar-legend {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
        }

        .legend-color {
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }

        .legend-color.morning {
            background: #f0ad4e;
        }

        .legend-color.afternoon {
            background: #1f9bcf;
        }

        .legend-color.night {
            background: #6f42c1;
        }

        .legend-color.free {
            background: #4bbf73;
        }

        /* Footer */
        footer {
            text-align: center;
            margin-top: 3rem;
            padding: 2rem 0;
        }

        footer a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 0.875rem;
            transition: color 0.2s;
        }

        footer a:hover {
            color: white;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2rem;
            }

            .card-body {
                padding: 1.5rem;
            }

            .calendar-day-header {
                font-size: 0.625rem;
                padding: 0.25rem;
            }

            .calendar-day .day-number {
                font-size: 0.875rem;
            }

            .calendar-day .shift-indicator {
                font-size: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="page-header">
            <h1>Horaire de Miaro</h1>
            <div class="subtitle">Suivi en temps réel du planning de travail</div>
        </header>

        <main>
            <!-- Current Status Card -->
            <div class="card">
                <div class="card-header">Statut Actuel</div>
                <div class="card-body">
                    <div class="status-container">
                        {{ if eq .IsWorking "est au travail" }}
                        <div class="status-badge working">
                            <span class="status-indicator"></span>
                            <span>Au travail</span>
                        </div>
                        {{ else }}
                        <div class="status-badge not-working">
                            <span class="status-indicator"></span>
                            <span>Pas au travail</span>
                        </div>
                        {{ end }}
                    </div>

                    {{ if eq .Schedule "du matin" }}
                    <div class="shift-morning">
                        <div class="schedule-info">
                            <div class="schedule-details">
                                <h3>Équipe du Matin</h3>
                                <p class="schedule-time">06:00 - 14:00</p>
                            </div>
                        </div>
                    </div>
                    {{ else if eq .Schedule "de l'après-midi" }}
                    <div class="shift-afternoon">
                        <div class="schedule-info">
                            <div class="schedule-details">
                                <h3>Équipe de l'Après-midi</h3>
                                <p class="schedule-time">14:00 - 22:00</p>
                            </div>
                        </div>
                    </div>
                    {{ else if eq .Schedule "de nuit" }}
                    <div class="shift-night">
                        <div class="schedule-info">
                            <div class="schedule-details">
                                <h3>Équipe de Nuit</h3>
                                <p class="schedule-time">22:00 - 06:00</p>
                            </div>
                        </div>
                    </div>
                    {{ else if eq .Schedule "libre" }}
                    <div class="shift-free">
                        <div class="schedule-info">
                            <div class="schedule-details">
                                <h3>Jour de Repos</h3>
                                <p class="schedule-time">Temps libre</p>
                            </div>
                        </div>
                    </div>
                    {{ end }}
                </div>
            </div>

            <!-- Calendar View Card -->
            <div class="card">
                <div class="card-header">Planning du Mois</div>
                <div class="card-body">
                    <div class="calendar-header">
                        <h3>Prochain jour de travail: {{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}</h3>
                    </div>

                    <div class="calendar-grid">
                        <div class="calendar-day-header">Lun</div>
                        <div class="calendar-day-header">Mar</div>
                        <div class="calendar-day-header">Mer</div>
                        <div class="calendar-day-header">Jeu</div>
                        <div class="calendar-day-header">Ven</div>
                        <div class="calendar-day-header">Sam</div>
                        <div class="calendar-day-header">Dim</div>

                        {{ range .CalendarDays }}
                        <div class="calendar-day {{ if .IsEmpty }}empty{{ end }} {{ if .IsToday }}today{{ end }} {{ if .IsNextWork }}next-work{{ end }}">
                            {{ if not .IsEmpty }}
                            <div class="day-number">{{ .DayNumber }}</div>
                            <div class="shift-indicator">{{ .ShiftType }}</div>
                            {{ end }}
                        </div>
                        {{ end }}
                    </div>

                    <div class="calendar-legend">
                        <div class="legend-item">
                            <div class="legend-color morning"></div>
                            <span>Matin</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-color afternoon"></div>
                            <span>Après-midi</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-color night"></div>
                            <span>Nuit</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-color free"></div>
                            <span>Libre</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api" target="_blank" rel="noopener">&copy; 2024 Disqt - Miaro Scheduler API</a>
        </footer>
    </div>
</body>
</html>
{{ end }}
