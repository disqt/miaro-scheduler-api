{{ define "miaroSchedule.tmpl" }}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horaire de Miaro - Scheduler API</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
            margin: 0;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
            flex: 1;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

        header h1 {
            font-size: 2.5em;
            margin: 0 0 10px 0;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        header .subtitle {
            font-size: 1.1em;
            opacity: 0.95;
            font-weight: 300;
        }

        .card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            padding: 32px;
            margin-bottom: 24px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.2);
        }

        .card-title {
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            margin: 0 0 20px 0;
            font-weight: 600;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 16px 24px;
            border-radius: 12px;
            font-size: 1.4em;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .status-badge.working {
            background: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }

        .status-badge.not-working {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }

        .status-icon {
            font-size: 1.5em;
        }

        .schedule-info {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 12px;
            margin-top: 16px;
        }

        .schedule-icon {
            font-size: 2.5em;
            min-width: 60px;
            text-align: center;
        }

        .schedule-details {
            flex: 1;
        }

        .schedule-type {
            font-size: 1.5em;
            font-weight: 700;
            margin: 0 0 8px 0;
            color: #333;
        }

        .schedule-time {
            font-size: 1.1em;
            color: #666;
            margin: 0;
        }

        /* Shift-specific colors */
        .shift-morning .schedule-icon {
            color: #ff8c00;
        }
        .shift-morning .schedule-info {
            background: linear-gradient(135deg, #fff5e6 0%, #ffe6cc 100%);
            border-left: 4px solid #ff8c00;
        }

        .shift-afternoon .schedule-icon {
            color: #4a90e2;
        }
        .shift-afternoon .schedule-info {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-left: 4px solid #4a90e2;
        }

        .shift-night .schedule-icon {
            color: #5b4e8e;
        }
        .shift-night .schedule-info {
            background: linear-gradient(135deg, #ede7f6 0%, #d1c4e9 100%);
            border-left: 4px solid #5b4e8e;
        }

        .shift-free .schedule-icon {
            color: #4caf50;
        }
        .shift-free .schedule-info {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            border-left: 4px solid #4caf50;
        }

        .next-work-label {
            font-size: 1.1em;
            color: #666;
            margin: 0 0 8px 0;
        }

        .next-work-date {
            font-size: 1.6em;
            font-weight: 700;
            color: #333;
            margin: 0 0 20px 0;
        }

        .info-note {
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 16px 20px;
            border-radius: 8px;
            margin-top: 24px;
            font-size: 0.95em;
            color: #856404;
        }

        .info-note-icon {
            font-weight: bold;
            margin-right: 8px;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px 0;
            color: white;
            font-size: 0.9em;
        }

        footer a {
            color: white;
            text-decoration: none;
            opacity: 0.9;
            transition: opacity 0.2s;
        }

        footer a:hover {
            opacity: 1;
            text-decoration: underline;
        }

        @media (max-width: 600px) {
            body {
                padding: 12px;
            }

            header h1 {
                font-size: 1.8em;
            }

            .card {
                padding: 20px;
            }

            .status-badge {
                font-size: 1.1em;
                padding: 12px 16px;
            }

            .schedule-info {
                flex-direction: column;
                text-align: center;
            }

            .schedule-type {
                font-size: 1.2em;
            }

            .next-work-date {
                font-size: 1.3em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📅 Horaire de Miaro</h1>
            <div class="subtitle">Suivi en temps réel du planning de travail</div>
        </header>

        <main>
            <!-- Current Status Card -->
            <article class="card">
                <h2 class="card-title">Statut Actuel</h2>

                {{ if eq .IsWorking "est au travail" }}
                <div class="status-badge working">
                    <span class="status-icon">✓</span>
                    <span>Au travail</span>
                </div>
                {{ else }}
                <div class="status-badge not-working">
                    <span class="status-icon">○</span>
                    <span>Pas au travail</span>
                </div>
                {{ end }}

                {{ if eq .Schedule "du matin" }}
                <div class="schedule-info shift-morning">
                    <div class="schedule-icon">☀️</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Équipe du Matin</p>
                        <p class="schedule-time">⏰ 6h00 - 14h00</p>
                    </div>
                </div>
                {{ else if eq .Schedule "de l'après-midi" }}
                <div class="schedule-info shift-afternoon">
                    <div class="schedule-icon">🌤️</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Équipe de l'Après-midi</p>
                        <p class="schedule-time">⏰ 14h00 - 22h00</p>
                    </div>
                </div>
                {{ else if eq .Schedule "de nuit" }}
                <div class="schedule-info shift-night">
                    <div class="schedule-icon">🌙</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Équipe de Nuit</p>
                        <p class="schedule-time">⏰ 22h00 - 6h00</p>
                    </div>
                </div>
                {{ else if eq .Schedule "libre" }}
                <div class="schedule-info shift-free">
                    <div class="schedule-icon">🏖️</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Jour de Repos</p>
                        <p class="schedule-time">✨ Temps libre</p>
                    </div>
                </div>
                {{ end }}
            </article>

            <!-- Next Working Day Card -->
            <article class="card">
                <h2 class="card-title">Prochain Jour de Travail</h2>

                <p class="next-work-label">📅 Date</p>
                <p class="next-work-date">{{ if eq .NextWorkingDay "demain" }}Demain{{ else }}{{ .NextWorkingDay | title }}{{ end }}</p>

                {{ if eq .ScheduleNextWorkingDay "du matin" }}
                <div class="schedule-info shift-morning">
                    <div class="schedule-icon">☀️</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Équipe du Matin</p>
                        <p class="schedule-time">⏰ 6h00 - 14h00</p>
                    </div>
                </div>
                {{ else if eq .ScheduleNextWorkingDay "de l'après-midi" }}
                <div class="schedule-info shift-afternoon">
                    <div class="schedule-icon">🌤️</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Équipe de l'Après-midi</p>
                        <p class="schedule-time">⏰ 14h00 - 22h00</p>
                    </div>
                </div>
                {{ else if eq .ScheduleNextWorkingDay "de nuit" }}
                <div class="schedule-info shift-night">
                    <div class="schedule-icon">🌙</div>
                    <div class="schedule-details">
                        <p class="schedule-type">Équipe de Nuit</p>
                        <p class="schedule-time">⏰ 22h00 - 6h00</p>
                    </div>
                </div>
                {{ end }}

                <div class="info-note">
                    <span class="info-note-icon">ℹ️</span>
                    <span>Ces informations sont calculées selon le cycle habituel. Des exceptions peuvent s'appliquer.</span>
                </div>
            </article>
        </main>

        <footer>
            <a href="https://github.com/disqt/miaro-scheduler-api" target="_blank" rel="noopener">&copy; 2024 Disqt - Miaro Scheduler API</a>
        </footer>
    </div>
</body>
</html>
{{ end }}
